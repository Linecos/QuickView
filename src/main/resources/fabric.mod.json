{
  "schemaVersion": 1,
  "id": "quickview",
  "version": "${version}",
  "name": "QuickView",
  "description": "视角书签系统：保存相机机位，一键瞬间切换视角，一键恢复本体视角，期间玩家本体保持原位。",
  "authors": [
    "Linecos"
  ],
  "contact": {
    "homepage": "https://github.com/Linecos/QuickView",
    "sources": "https://github.com/Linecos/QuickView",
    "issues": "https://github.com/Linecos/QuickView/issues"
  },
  "license": "MIT",
  "icon": "assets/quickview/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.quickview.QuickViewClient"
    ]
  },
  "mixins": [
    "quickview.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.3",
    "fabric-api": ">=0.141.6",
    "libgui": ">=15.1.0 <16",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
